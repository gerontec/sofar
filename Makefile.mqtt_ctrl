# Makefile for MQTT Control Utilities
# Build command-line tools to control Pico via MQTT

CC = gcc
CFLAGS = -std=c11 -Wall -Wextra -O2
LDFLAGS = -lpaho-mqtt3c

# Targets
TARGETS = soyo_mqtt_ctrl relay_mqtt_ctrl pico_mqtt_daemon

.PHONY: all clean install install-daemon test

all: $(TARGETS)

soyo_mqtt_ctrl: soyo_mqtt_ctrl.c
	$(CC) $(CFLAGS) -o $@ $< $(LDFLAGS)

relay_mqtt_ctrl: relay_mqtt_ctrl.c
	$(CC) $(CFLAGS) -o $@ $< $(LDFLAGS)

pico_mqtt_daemon: pico_mqtt_daemon.c
	$(CC) $(CFLAGS) -o $@ $< $(LDFLAGS)

clean:
	rm -f $(TARGETS)

install: all
	install -m 755 soyo_mqtt_ctrl /usr/local/bin/
	install -m 755 relay_mqtt_ctrl /usr/local/bin/
	install -m 755 pico_mqtt_daemon /usr/local/bin/
	@echo "Installed to /usr/local/bin/"
	@echo ""
	@echo "Make sure MQTT broker is running:"
	@echo "  sudo apt install mosquitto mosquitto-clients"
	@echo "  sudo systemctl start mosquitto"
	@echo ""
	@echo "To install daemon as systemd service:"
	@echo "  sudo make install-daemon"

install-daemon: install
	install -m 644 pico-mqtt-daemon.service /etc/systemd/system/
	systemctl daemon-reload
	@echo "Daemon installed! To enable and start:"
	@echo "  sudo systemctl enable pico-mqtt-daemon"
	@echo "  sudo systemctl start pico-mqtt-daemon"
	@echo "  sudo systemctl status pico-mqtt-daemon"

uninstall:
	rm -f /usr/local/bin/soyo_mqtt_ctrl
	rm -f /usr/local/bin/relay_mqtt_ctrl
	rm -f /usr/local/bin/pico_mqtt_daemon

uninstall-daemon:
	systemctl stop pico-mqtt-daemon || true
	systemctl disable pico-mqtt-daemon || true
	rm -f /etc/systemd/system/pico-mqtt-daemon.service
	systemctl daemon-reload

# Test MQTT broker connectivity
test-broker:
	@echo "Testing MQTT broker..."
	@mosquitto_pub -h localhost -t "test" -m "hello" && echo "✓ MQTT broker is running" || echo "✗ MQTT broker not accessible"

# Test tools
test: all
	@echo "Testing SOYO MQTT control..."
	./soyo_mqtt_ctrl localhost 0
	@echo ""
	@echo "Testing Relay MQTT control..."
	./relay_mqtt_ctrl localhost 0

# Monitor MQTT traffic
monitor:
	@echo "Monitoring MQTT topics (Ctrl+C to stop)..."
	mosquitto_sub -h localhost -t "pico/#" -v

# Daemon control
daemon-start:
	sudo systemctl start pico-mqtt-daemon

daemon-stop:
	sudo systemctl stop pico-mqtt-daemon

daemon-restart:
	sudo systemctl restart pico-mqtt-daemon

daemon-status:
	sudo systemctl status pico-mqtt-daemon

daemon-logs:
	sudo journalctl -u pico-mqtt-daemon -f

# Help
help:
	@echo "MQTT Control Utilities - Makefile"
	@echo ""
	@echo "Build Targets:"
	@echo "  make              - Build all tools + daemon"
	@echo "  make clean        - Remove binaries"
	@echo ""
	@echo "Install Targets:"
	@echo "  make install      - Install to /usr/local/bin"
	@echo "  make install-daemon - Install systemd service (requires sudo)"
	@echo "  make uninstall    - Remove binaries"
	@echo "  make uninstall-daemon - Remove systemd service"
	@echo ""
	@echo "Test Targets:"
	@echo "  make test         - Test tools"
	@echo "  make test-broker  - Check MQTT broker"
	@echo "  make monitor      - Monitor MQTT traffic"
	@echo ""
	@echo "Daemon Control:"
	@echo "  make daemon-start   - Start daemon"
	@echo "  make daemon-stop    - Stop daemon"
	@echo "  make daemon-restart - Restart daemon"
	@echo "  make daemon-status  - Show status"
	@echo "  make daemon-logs    - Show logs (follow)"
	@echo ""
	@echo "Dependencies:"
	@echo "  sudo apt install libpaho-mqtt-dev mosquitto mosquitto-clients"
	@echo ""
	@echo "Usage examples:"
	@echo "  soyo_mqtt_ctrl localhost 1500       # Set 1500W"
	@echo "  relay_mqtt_ctrl localhost 3         # Set relay state 3"
	@echo "  pico_mqtt_daemon localhost          # Run daemon (foreground)"
	@echo "  mosquitto_sub -t 'pico/#' -v        # Monitor MQTT"
