#!/bin/bash
# Configuration script for read_inverter
# Checks dependencies and system requirements

set -e

echo "=== Read Inverter - Configuration Check ==="
echo ""

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

ERRORS=0
WARNINGS=0

# Check for required commands
echo "Checking build tools..."

if command -v gcc >/dev/null 2>&1; then
    GCC_VERSION=$(gcc --version | head -n1)
    echo -e "${GREEN}✓${NC} GCC found: $GCC_VERSION"
else
    echo -e "${RED}✗${NC} GCC not found"
    echo "  Install with: sudo apt-get install build-essential"
    ERRORS=$((ERRORS + 1))
fi

if command -v make >/dev/null 2>&1; then
    MAKE_VERSION=$(make --version | head -n1)
    echo -e "${GREEN}✓${NC} Make found: $MAKE_VERSION"
else
    echo -e "${RED}✗${NC} Make not found"
    echo "  Install with: sudo apt-get install build-essential"
    ERRORS=$((ERRORS + 1))
fi

echo ""
echo "Checking required libraries..."

# Check for libmodbus
if pkg-config --exists libmodbus 2>/dev/null; then
    MODBUS_VERSION=$(pkg-config --modversion libmodbus)
    echo -e "${GREEN}✓${NC} libmodbus found: $MODBUS_VERSION"
elif [ -f /usr/include/modbus/modbus.h ] || [ -f /usr/local/include/modbus/modbus.h ]; then
    echo -e "${YELLOW}⚠${NC} modbus.h found but pkg-config not available"
    WARNINGS=$((WARNINGS + 1))
else
    echo -e "${RED}✗${NC} libmodbus not found"
    echo "  Install with: sudo apt-get install libmodbus-dev"
    ERRORS=$((ERRORS + 1))
fi

echo ""
echo "Checking system configuration..."

# Check for serial port
if [ -e /dev/ttyUSB32 ]; then
    echo -e "${GREEN}✓${NC} Serial port /dev/ttyUSB32 exists"

    # Check permissions
    if [ -r /dev/ttyUSB32 ] && [ -w /dev/ttyUSB32 ]; then
        echo -e "${GREEN}✓${NC} Current user has read/write access to /dev/ttyUSB32"
    else
        echo -e "${YELLOW}⚠${NC} No read/write access to /dev/ttyUSB32"
        echo "  Add user to dialout group: sudo usermod -a -G dialout $USER"
        echo "  Then log out and back in"
        WARNINGS=$((WARNINGS + 1))
    fi
else
    echo -e "${YELLOW}⚠${NC} Serial port /dev/ttyUSB32 not found"
    echo "  Port may be different or device not connected"
    echo "  Edit read_config.h to change SERIAL_PORT if needed"
    WARNINGS=$((WARNINGS + 1))
fi

# Check for CSV file
CSV_FILE="/home/pi/python/sofarregister.csv"
if [ -f "$CSV_FILE" ]; then
    echo -e "${GREEN}✓${NC} Register CSV file found: $CSV_FILE"
else
    echo -e "${YELLOW}⚠${NC} Register CSV file not found: $CSV_FILE"
    echo "  Edit read_config.h to set correct CSV_FILE path"
    WARNINGS=$((WARNINGS + 1))
fi

# Check for output directory
if [ -d /tmp ] && [ -w /tmp ]; then
    echo -e "${GREEN}✓${NC} Output directory /tmp is writable"
else
    echo -e "${RED}✗${NC} Cannot write to /tmp"
    ERRORS=$((ERRORS + 1))
fi

echo ""
echo "=== Configuration Summary ==="
echo ""

if [ $ERRORS -eq 0 ] && [ $WARNINGS -eq 0 ]; then
    echo -e "${GREEN}All checks passed!${NC}"
    echo ""
    echo "You can now build the project with:"
    echo "  make"
    echo ""
    exit 0
elif [ $ERRORS -eq 0 ]; then
    echo -e "${YELLOW}Configuration completed with $WARNINGS warning(s)${NC}"
    echo ""
    echo "You can try to build the project with:"
    echo "  make"
    echo ""
    echo "Some features may not work correctly."
    exit 0
else
    echo -e "${RED}Configuration failed with $ERRORS error(s) and $WARNINGS warning(s)${NC}"
    echo ""
    echo "Please install missing dependencies before building."
    echo ""
    echo "Quick install for Debian/Ubuntu:"
    echo "  sudo apt-get update"
    echo "  sudo apt-get install build-essential libmodbus-dev"
    echo ""
    exit 1
fi
