#!/bin/bash
# Configuration script for soyo1min C version
# Checks dependencies and system requirements

set -e

echo "=== Soyo1min C Version - Configuration Check ==="
echo ""

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

ERRORS=0
WARNINGS=0

# Check for required commands
echo "Checking build tools..."

if command -v gcc >/dev/null 2>&1; then
    GCC_VERSION=$(gcc --version | head -n1)
    echo -e "${GREEN}✓${NC} GCC found: $GCC_VERSION"
else
    echo -e "${RED}✗${NC} GCC not found"
    echo "  Install with: sudo apt-get install build-essential"
    ERRORS=$((ERRORS + 1))
fi

if command -v make >/dev/null 2>&1; then
    MAKE_VERSION=$(make --version | head -n1)
    echo -e "${GREEN}✓${NC} Make found: $MAKE_VERSION"
else
    echo -e "${RED}✗${NC} Make not found"
    echo "  Install with: sudo apt-get install build-essential"
    ERRORS=$((ERRORS + 1))
fi

echo ""
echo "Checking required libraries..."

# Check for mosquitto library
if pkg-config --exists libmosquitto 2>/dev/null; then
    MOSQ_VERSION=$(pkg-config --modversion libmosquitto)
    echo -e "${GREEN}✓${NC} libmosquitto found: $MOSQ_VERSION"
elif [ -f /usr/include/mosquitto.h ] || [ -f /usr/local/include/mosquitto.h ]; then
    echo -e "${YELLOW}⚠${NC} mosquitto.h found but pkg-config not available"
    WARNINGS=$((WARNINGS + 1))
else
    echo -e "${RED}✗${NC} libmosquitto not found"
    echo "  Install with: sudo apt-get install libmosquitto-dev"
    ERRORS=$((ERRORS + 1))
fi

# Check for math library (usually included)
if [ -f /usr/lib/*/libm.so ] || [ -f /usr/lib/libm.so ] || [ -f /lib/*/libm.so ]; then
    echo -e "${GREEN}✓${NC} libm (math library) found"
else
    echo -e "${YELLOW}⚠${NC} libm not found in standard locations (may still work)"
    WARNINGS=$((WARNINGS + 1))
fi

echo ""
echo "Checking system configuration..."

# Check for serial port
if [ -e /dev/ttyUSB32 ]; then
    echo -e "${GREEN}✓${NC} Serial port /dev/ttyUSB32 exists"

    # Check permissions
    if [ -r /dev/ttyUSB32 ] && [ -w /dev/ttyUSB32 ]; then
        echo -e "${GREEN}✓${NC} Current user has read/write access to /dev/ttyUSB32"
    else
        echo -e "${YELLOW}⚠${NC} No read/write access to /dev/ttyUSB32"
        echo "  Add user to dialout group: sudo usermod -a -G dialout $USER"
        echo "  Then log out and back in"
        WARNINGS=$((WARNINGS + 1))
    fi
else
    echo -e "${YELLOW}⚠${NC} Serial port /dev/ttyUSB32 not found"
    echo "  Port may be different or device not connected"
    echo "  Edit config.h to change SERIAL_PORT if needed"
    WARNINGS=$((WARNINGS + 1))
fi

# Check for required directories
if [ -d /run/user/1000 ]; then
    echo -e "${GREEN}✓${NC} Runtime directory /run/user/1000 exists"

    if [ -w /run/user/1000 ]; then
        echo -e "${GREEN}✓${NC} Runtime directory is writable"
    else
        echo -e "${YELLOW}⚠${NC} Runtime directory /run/user/1000 not writable"
        WARNINGS=$((WARNINGS + 1))
    fi
else
    echo -e "${YELLOW}⚠${NC} Runtime directory /run/user/1000 not found"
    echo "  Create with: mkdir -p /run/user/1000"
    echo "  Or edit config.h to change paths"
    WARNINGS=$((WARNINGS + 1))
fi

echo ""
echo "Checking optional dependencies..."

# Check for Python and sunrise.py
if command -v python3 >/dev/null 2>&1; then
    PYTHON_VERSION=$(python3 --version)
    echo -e "${GREEN}✓${NC} Python3 found: $PYTHON_VERSION"
else
    echo -e "${YELLOW}⚠${NC} Python3 not found (needed for sunrise.py)"
    WARNINGS=$((WARNINGS + 1))
fi

if [ -f ../sunrise.py ]; then
    echo -e "${GREEN}✓${NC} sunrise.py found in parent directory"
elif [ -f ./sunrise.py ]; then
    echo -e "${GREEN}✓${NC} sunrise.py found in current directory"

    # Test if sunrise.py works
    if python3 ./sunrise.py >/dev/null 2>&1; then
        echo -e "${GREEN}✓${NC} sunrise.py executes successfully"
    else
        echo -e "${YELLOW}⚠${NC} sunrise.py found but execution failed"
        echo "  Install Python dependencies with: pip3 install -r requirements.txt"
        WARNINGS=$((WARNINGS + 1))
    fi
else
    echo -e "${YELLOW}⚠${NC} sunrise.py not found"
    echo "  sunrise.py should be in the c-version directory"
    WARNINGS=$((WARNINGS + 1))
fi

# Check Python dependencies for sunrise.py
if command -v python3 >/dev/null 2>&1 && [ -f ./sunrise.py ]; then
    echo ""
    echo "Checking Python dependencies for sunrise.py..."

    if python3 -c "import astral" 2>/dev/null; then
        echo -e "${GREEN}✓${NC} Python package 'astral' found"
    else
        echo -e "${YELLOW}⚠${NC} Python package 'astral' not found"
        echo "  Install with: pip3 install astral"
        WARNINGS=$((WARNINGS + 1))
    fi

    if python3 -c "import pytz" 2>/dev/null; then
        echo -e "${GREEN}✓${NC} Python package 'pytz' found"
    else
        echo -e "${YELLOW}⚠${NC} Python package 'pytz' not found"
        echo "  Install with: pip3 install pytz"
        WARNINGS=$((WARNINGS + 1))
    fi
fi

# Check for MQTT broker connectivity (optional)
MQTT_BROKER="192.168.178.218"
if command -v mosquitto_sub >/dev/null 2>&1; then
    echo -e "${GREEN}✓${NC} mosquitto_sub found (can test MQTT connectivity)"

    if timeout 2 mosquitto_sub -h "$MQTT_BROKER" -t "test" -C 1 >/dev/null 2>&1; then
        echo -e "${GREEN}✓${NC} MQTT broker $MQTT_BROKER is reachable"
    else
        echo -e "${YELLOW}⚠${NC} Cannot reach MQTT broker $MQTT_BROKER"
        echo "  Check network connectivity and broker settings in config.h"
        WARNINGS=$((WARNINGS + 1))
    fi
else
    echo -e "${YELLOW}⚠${NC} mosquitto_sub not found (optional, for testing)"
fi

echo ""
echo "=== Configuration Summary ==="
echo ""

if [ $ERRORS -eq 0 ] && [ $WARNINGS -eq 0 ]; then
    echo -e "${GREEN}All checks passed!${NC}"
    echo ""
    echo "You can now build the project with:"
    echo "  make"
    echo ""
    exit 0
elif [ $ERRORS -eq 0 ]; then
    echo -e "${YELLOW}Configuration completed with $WARNINGS warning(s)${NC}"
    echo ""
    echo "You can try to build the project with:"
    echo "  make"
    echo ""
    echo "Some features may not work correctly."
    exit 0
else
    echo -e "${RED}Configuration failed with $ERRORS error(s) and $WARNINGS warning(s)${NC}"
    echo ""
    echo "Please install missing dependencies before building."
    echo ""
    echo "Quick install for Debian/Ubuntu/Raspberry Pi OS:"
    echo "  sudo apt-get update"
    echo "  sudo apt-get install build-essential libmosquitto-dev"
    echo ""
    exit 1
fi
