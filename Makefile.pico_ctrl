# Makefile for Pico Control Utilities
# Build command-line tools to control Pico Modbus daemon

CC = gcc
CFLAGS = -std=c11 -Wall -Wextra -O2
LDFLAGS =

# Targets
TARGETS = soyo_ctrl relay_ctrl

.PHONY: all clean install

all: $(TARGETS)

soyo_ctrl: soyo_ctrl.c
	$(CC) $(CFLAGS) -o $@ $< $(LDFLAGS)

relay_ctrl: relay_ctrl.c
	$(CC) $(CFLAGS) -o $@ $< $(LDFLAGS)

clean:
	rm -f $(TARGETS)

install: all
	install -m 755 soyo_ctrl /usr/local/bin/
	install -m 755 relay_ctrl /usr/local/bin/
	@echo "Installed to /usr/local/bin/"
	@echo "Make sure /dev/ttyACM0 has correct permissions:"
	@echo "  sudo usermod -a -G dialout $(USER)"
	@echo "  sudo chmod 666 /dev/ttyACM0"

uninstall:
	rm -f /usr/local/bin/soyo_ctrl
	rm -f /usr/local/bin/relay_ctrl

# Test targets
test: all
	@echo "Testing SOYO control..."
	./soyo_ctrl status
	@echo ""
	@echo "Testing Relay control..."
	./relay_ctrl status

# Help
help:
	@echo "Pico Control Utilities - Makefile"
	@echo ""
	@echo "Targets:"
	@echo "  make              - Build all tools"
	@echo "  make clean        - Remove binaries"
	@echo "  make install      - Install to /usr/local/bin"
	@echo "  make uninstall    - Remove from /usr/local/bin"
	@echo "  make test         - Test tools (requires Pico connected)"
	@echo ""
	@echo "Usage examples:"
	@echo "  soyo_ctrl 1500    - Set SOYO to 1500W"
	@echo "  relay_ctrl 3      - Set relay state 3 (R1+R2 ON)"
	@echo "  soyo_ctrl status  - Query status"
